<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:key="key_info"
        app:summary="test"
        app:title="App">

        <ListPreference
            app:entries="@array/languages"
            app:entryValues="@array/languages_aliases"
            app:key="@string/settings_language_key"
            app:title="@string/settings_language_name"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/settings_webdav_header">

        <Preference
            app:key="@string/settings_storage_key"
            app:title="@string/settings_storage" />

        <Preference
            app:key="@string/settings_shared_libraries_key"
            app:title="@string/settings_shared_libraries" />

        <Preference
            app:key="@string/settings_sync_now_key"
            app:title="@string/settings_sync_now" />

    </PreferenceCategory>

</PreferenceScreen>
