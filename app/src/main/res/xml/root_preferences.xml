<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:key="key_info"
        app:summary="test"
        app:title="App">

        <ListPreference
            app:entries="@array/languages"
            app:entryValues="@array/languages_aliases"
            app:key="@string/settings_language_key"
            app:title="@string/settings_language_name"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/settings_account_header">

        <EditTextPreference
            app:key="@string/settings_account_name_key"
            app:title="@string/settings_account_name"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            android:dependency="@string/settings_account_name_key"
            app:key="@string/settings_account_password_key"
            app:summary="******"
            app:title="@string/settings_account_password"
            app:useSimpleSummaryProvider="false" />

        <click.alchemist.cook.ui.settings.SyncStatusPreference app:key="@string/settings_account_sync_key" />

    </PreferenceCategory>

</PreferenceScreen>
